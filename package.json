{
  "name": "@genoacms/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for GenoaCMS: core, cloud abstraction layer and its adapters",
  "author": {
    "name": "Filip Holčík",
    "email": "filip.holcik.official@gmail.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenoaCMS/genoacms.git"
  },
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "build": "pnpm -r --no-bail run build",
    "test": "pnpm -r --no-bail run test",
    "lint": "pnpm -r --no-bail run lint",
    "check": "pnpm -r --no-bail run check",
    "dev": "pnpm --filter @genoacms/core dev",
    "docs:dev": "pnpm --filter @genoacms/docs dev",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish",
    "docs:check": "node docs/tools/check-docs.mjs docs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@sveltepress/theme-default@8.9.0": "patches/@sveltepress__theme-default@8.9.0.patch"
    }
  }
}
