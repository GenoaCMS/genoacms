{
  "name": "@genoacms/adapter-aws",
  "version": "0.6.2-fix.3",
  "description": "Adapter for abstraction layer for GenoaCMS",
  "author": {
    "name": "Filip Holčík",
    "email": "filip.holcik.official@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenoaCMS/genoacms.git",
    "directory": "packages/adapter-aws"
  },
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run src",
    "test:conformance": "vitest run test"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.598.0",
    "@aws-sdk/client-dynamodb": "^3.436.0",
    "@aws-sdk/client-lambda": "^3.540.0",
    "@aws-sdk/client-s3": "^3.436.0",
    "@aws-sdk/lib-storage": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.509.0",
    "archiver": "^7.0.1",
    "@genoacms/contracts": "workspace:^",
    "@sveltejs/adapter-node": "^5.2.12"
  },
  "devDependencies": {
    "eslint": "^8.52.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7",
    "@genoacms/conformance": "workspace:^",
    "@types/archiver": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "rimraf": "^5.0.5"
  },
  "exports": {
    "./storage": {
      "types": "./dist/storage/descriptor.d.ts",
      "import": "./dist/storage/descriptor.js"
    },
    "./storage/runtime": {
      "types": "./dist/storage/runtime.d.ts",
      "import": "./dist/storage/runtime.js"
    },
    "./database": {
      "types": "./dist/database/descriptor.d.ts",
      "import": "./dist/database/descriptor.js"
    },
    "./database/runtime": {
      "types": "./dist/database/runtime.d.ts",
      "import": "./dist/database/runtime.js"
    },
    "./deployment": {
      "types": "./dist/deployment/descriptor.d.ts",
      "import": "./dist/deployment/descriptor.js"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "files": [
    "dist",
    "deployment"
  ]
}
