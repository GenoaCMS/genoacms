  "type": "module",
  "scripts": {
    "test": "vitest run src",
    "test:conformance": "vitest run test"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.598.0",
    "@aws-sdk/client-dynamodb": "^3.436.0",
    "@aws-sdk/client-lambda": "^3.540.0",
    "@aws-sdk/client-s3": "^3.436.0",
    "@aws-sdk/lib-storage": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.509.0",
    "archiver": "^7.0.1",
    "uuid": "^9.0.1",
    "@genoacms/contracts": "workspace:^",
    "@sveltejs/adapter-node": "^5.2.12"
  },
  "devDependencies": {
    "dotenv": "^16.3.1",
    "eslint": "^8.52.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "jsdoc": "^4.0.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7",
    "@genoacms/conformance": "workspace:^"
  },
  "exports": {
    "./storage": {
      "types": "./src/storage/descriptor.d.ts",
      "import": "./src/storage/descriptor.js"
    },
    "./storage/runtime": {
      "import": "./src/storage/runtime.js"
    },
    "./database": {
      "types": "./src/database/descriptor.d.ts",
      "import": "./src/database/descriptor.js"
    },
    "./database/runtime": {
      "import": "./src/database/runtime.js"
    },
    "./deployment": {
      "types": "./src/deployment/descriptor.d.ts",
      "import": "./src/deployment/descriptor.js"
    }
