{
  "name": "@genoacms/adapter-gcp",
  "version": "0.8.2-1",
  "type": "module",
  "description": "Implementation of abstraction layer of GenoaCMS for GCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenoaCMS/genoacms.git",
    "directory": "packages/adapter-gcp"
  },
  "author": {
    "name": "Filip Holčík",
    "email": "filip.holcik.official@gmail.com"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GenoaCMS/genoacms/issues"
  },
  "homepage": "https://github.com/GenoaCMS/genoacms/tree/main/packages/adapter-gcp#readme",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:conformance": "vitest run test/conformance.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.1.0",
    "@google-cloud/functions": "^3.4.0",
    "@google-cloud/secret-manager": "^7.0.0",
    "@google-cloud/storage": "^7.7.0",
    "archiver": "^7.0.0",
    "@genoacms/contracts": "workspace:^",
    "@genoacms/sveltekit-adapter-cloud-run-functions": "workspace:^"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "eslint": "^8.52.0",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.2.2",
    "vitest": "^3.2.7",
    "@genoacms/conformance": "workspace:^"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./storage": {
      "types": "./dist/storage/descriptor.d.ts",
      "import": "./dist/storage/descriptor.js"
    },
    "./storage/runtime": {
      "types": "./dist/storage/runtime.d.ts",
      "import": "./dist/storage/runtime.js"
    },
    "./database": {
      "types": "./dist/database/descriptor.d.ts",
      "import": "./dist/database/descriptor.js"
    },
    "./database/runtime": {
      "types": "./dist/database/runtime.d.ts",
      "import": "./dist/database/runtime.js"
    },
    "./secrets": {
      "types": "./dist/secrets/descriptor.d.ts",
      "import": "./dist/secrets/descriptor.js"
    },
    "./secrets/runtime": {
      "types": "./dist/secrets/runtime.d.ts",
      "import": "./dist/secrets/runtime.js"
    },
    "./deployment": {
      "types": "./dist/deployment/descriptor.d.ts",
      "import": "./dist/deployment/descriptor.js"
    }
  }
}
