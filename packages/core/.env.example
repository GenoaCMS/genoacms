# Secrets for local development, read by @genoacms/adapter-secrets-env.
#
# Copy to `.env` and give the values your own. `.env` is gitignored; this file is not,
# so never put a real secret here.
#
#   cp .env.example .env
#
# In a deployment these live in a real secret manager instead — see the secrets service
# reference. Only the configuration changes; nothing in the application does.

# Signs session tokens. Use a long random value, unique per instance.
# Changing it invalidates every existing session.
GENOACMS_JWT_SECRET=replace-me-with-a-long-random-value
