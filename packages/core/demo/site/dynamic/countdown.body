const classed = (tag: string, classes: string): Element => {
  const node = dom.element(tag)
  node.setAttribute('class', classes)
  return node
}

const end = Date.parse(target)
const card = classed('div', 'rounded-2xl border border-white/15 bg-night/55 p-5 text-white backdrop-blur sm:p-6')
const caption = classed('p', 'mt-0 mb-4 text-xs font-bold uppercase tracking-widest opacity-80')
caption.append(dom.text(label))
card.append(caption)

const units: Array<[string, number]> = [['Days', 86400000], ['Hours', 3600000], ['Minutes', 60000], ['Seconds', 1000]]
const ROW = 'grid grid-cols-2 gap-2 text-center sm:grid-cols-4'
const row = classed('div', ROW)
const digits = units.map(([name]) => {
  const cell = classed('div', 'min-w-0 rounded-xl bg-white/10 px-1 py-4')
  const value = classed('span', 'block font-display text-3xl font-black leading-none tabular-nums text-accent sm:text-4xl')
  const unit = classed('span', 'mt-2 block text-xs uppercase tracking-widest opacity-70')
  value.append(dom.text('--'))
  unit.append(dom.text(name))
  cell.append(value, unit)
  row.append(cell)
  return value
})
card.append(row)

const DONE = 'm-0 text-2xl font-extrabold'
const done = classed('p', 'hidden ' + DONE)
done.append(dom.text(doneMessage))
card.append(done)

const showDone = (): void => {
  row.setAttribute('class', 'hidden')
  done.setAttribute('class', DONE)
}

const update = (): boolean => {
  const left = end - Date.now()
  if (!(left > 0)) {
    showDone()
    return false
  }
  digits.forEach((value, index) => {
    const [, size] = units[index]
    const whole = index === 0 ? Math.floor(left / size) : Math.floor(left / size) % (index === 1 ? 24 : 60)
    value.replaceChildren(dom.text(String(whole).padStart(2, '0')))
  })
  return true
}

let placed = false
const timer = setInterval(() => {
  if (card.isConnected) placed = true
  if (!update() || (placed && !card.isConnected)) clearInterval(timer)
}, 1000)
update()

return card
