const classed = (tag: string, classes: string): Element => {
  const node = dom.element(tag)
  node.setAttribute('class', classes)
  return node
}

const textOf = (tag: string, classes: string, value: string): Element => {
  const node = classed(tag, classes)
  node.append(dom.text(value))
  return node
}

const money = (amount: number): string =>
  currency + ' ' + (Math.round(amount / 100) * 100).toLocaleString('en-GB')

const LABEL = 'mb-2 block text-xs font-extrabold uppercase tracking-widest text-ink-soft'
const card = classed('div', 'grid min-w-0 gap-5 rounded-card border border-line bg-surface p-5 text-ink sm:p-8')
card.append(textOf('h3', 'm-0 font-display text-xl font-black uppercase tracking-wide', 'Estimate your fare'))

const low = Math.max(1, minArea)
const high = Math.max(low, maxArea)
const sizeBlock = dom.element('label')
const sizeHeading = classed('span', LABEL)
const sizeValue = dom.element('span')
sizeHeading.append(dom.text('Cabin size: '), sizeValue)
const size = dom.element('input')
size.setAttribute('type', 'range')
size.setAttribute('min', String(low))
size.setAttribute('max', String(high))
size.setAttribute('step', '2')
size.setAttribute('value', String(Math.min(high, Math.max(low, 18))))
size.setAttribute('class', 'w-full cursor-pointer accent-accent')
sizeBlock.append(sizeHeading, size)
card.append(sizeBlock)

const deckBlock = dom.element('label')
deckBlock.append(textOf('span', LABEL, 'Deck'))
const deck = dom.element('select')
deck.setAttribute('class', 'w-full min-w-0 cursor-pointer rounded-lg border border-line bg-paper p-3 text-sm text-ink sm:text-base')
const decks: Array<[string, string]> = [['crew', 'Crew deck, inboard cabin'], ['observation', 'Observation deck, forward viewport']]
decks.forEach(([value, text]) => {
  const option = dom.element('option')
  option.setAttribute('value', value)
  option.append(dom.text(text))
  deck.append(option)
})
deckBlock.append(deck)
card.append(deckBlock)

const toggle = (text: string): Element => {
  const row = classed('label', 'flex cursor-pointer items-center gap-3')
  const box = dom.element('input')
  box.setAttribute('type', 'checkbox')
  box.setAttribute('class', 'size-4 shrink-0 accent-accent')
  row.append(box, dom.text(text))
  card.append(row)
  return box
}
const cryo = toggle('Cryo-sleep through the transit legs (−' + cryoDiscount + '%)')
const eva = toggle('Shuttle excursion at the Arches Cluster')

const result = classed('div', 'rounded-xl border border-line bg-night px-5 py-5')
const total = dom.element('span')
const detail = dom.element('span')
const totalLine = classed('p', 'm-0 font-display text-3xl font-black leading-tight text-accent')
totalLine.append(total)
const detailLine = classed('p', 'mt-1.5 mb-0 text-sm opacity-80')
detailLine.append(detail)
result.append(textOf('p', 'mt-0 mb-1 text-xs uppercase tracking-widest opacity-70', 'Estimated round-trip fare'), totalLine, detailLine)
card.append(result)

const cta = textOf('a', 'inline-flex justify-center rounded-full bg-accent px-6 py-3 font-bold text-accent-ink no-underline transition hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal', 'Hold this berth')
cta.setAttribute('href', contactLink)
card.append(cta)

const checked = (box: Element): boolean => (box as HTMLInputElement).checked

const recalculate = (): void => {
  const metres = Number((size as HTMLInputElement).value)
  const rate = (deck as HTMLSelectElement).value === 'observation' ? observationRate : standardRate
  const cabin = metres * rate
  const afterCryo = checked(cryo) ? cabin * (1 - cryoDiscount / 100) : cabin
  const fare = afterCryo + (checked(eva) ? evaFee : 0)
  sizeValue.replaceChildren(dom.text(metres + ' m²'))
  total.replaceChildren(dom.text(money(fare)))
  detail.replaceChildren(dom.text(metres + ' m² × ' + money(rate) + ' per m²' + (checked(cryo) ? ', cryo-sleep' : '') + (checked(eva) ? ', shuttle excursion' : '')))
}

;[size, deck, cryo, eva].forEach(control => {
  control.addEventListener('input', recalculate)
  control.addEventListener('change', recalculate)
})
recalculate()

return card
