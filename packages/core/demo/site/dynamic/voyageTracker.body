const classed = (tag: string, classes: string): Element => {
  const node = dom.element(tag)
  node.setAttribute('class', classes)
  return node
}

const textOf = (tag: string, classes: string, value: string): Element => {
  const node = classed(tag, classes)
  node.append(dom.text(value))
  return node
}

const CARD = 'pointer-events-auto grid w-full gap-2.5 rounded-2xl border border-white/15 bg-night/75 px-5 py-5 text-ink backdrop-blur'
const EYEBROW = 'm-0 text-xs font-extrabold uppercase tracking-widest text-signal'
const root = classed('div', 'pointer-events-none flex w-full flex-1 flex-col justify-between gap-4 pt-6')
const stopCard = classed('div', CARD + ' max-w-sm self-end')
const card = classed('div', CARD + ' max-w-md self-start')
root.append(stopCard, card)
card.append(textOf('p', EYEBROW, label))

const THREE = passthrough.THREE as any
const galaxy = passthrough.galaxy as any
const staged = THREE !== undefined && galaxy !== undefined

const DAY = 86400000
const TOTAL_LIGHT_YEARS = 26000
const DOT = 'size-2 shrink-0 rounded-full '
const DOT_PAST = DOT + 'bg-accent opacity-60'
const DOT_CURRENT = DOT + 'bg-accent ring-4 ring-accent/30'
const DOT_AHEAD = DOT + 'bg-white/20'

const stops = waypoints.split('\n').map(line => line.split('|').map(part => part.trim()))
  .filter(parts => parts.length > 1)
  .map(parts => ({ day: Number(parts[0]), name: parts[1], note: parts.slice(2).join(' | ') }))
  .filter(stop => Number.isFinite(stop.day))

const drawShip = (): ((progress: number) => void) => {
  const glow = galaxy.glow()
  const additive = (color: string, opacity: number): unknown =>
    new THREE.MeshBasicMaterial({ color, transparent: true, opacity, blending: THREE.AdditiveBlending, depthWrite: false })

  const ship = new THREE.Group()
  const hull = new THREE.Mesh(new THREE.ConeGeometry(0.2, 1.1, 20), new THREE.MeshBasicMaterial({ color: '#f4f6ff' }))
  hull.rotation.x = Math.PI / 2
  ship.add(hull)
  ;[-0.28, 0.22].forEach(offset => {
    const ring = new THREE.Mesh(new THREE.TorusGeometry(0.46, 0.06, 4, 6), additive('#ffb547', 0.95))
    ring.position.z = offset
    ring.userData.spin = offset > 0 ? 2.6 : -2.6
    ship.add(ring)
  })
  const halo = new THREE.Sprite(new THREE.SpriteMaterial({ map: glow, color: '#ffcf8a', transparent: true, depthWrite: false, blending: THREE.AdditiveBlending }))
  halo.scale.setScalar(2.6)
  ship.add(halo)
  ship.scale.setScalar(1.8)

  const markers = new THREE.Group()
  stops.filter(stop => stop.day > 0 && stop.day < durationDays).forEach((stop, index) => {
    const at = galaxy.routePoint(stop.day / durationDays)
    const dot = new THREE.Sprite(new THREE.SpriteMaterial({ map: glow, color: '#5fd4ff', transparent: true, depthWrite: false, blending: THREE.AdditiveBlending }))
    dot.scale.setScalar(1.3)
    dot.position.copy(at)
    const name = galaxy.label(stop.name, '#9fe3ff')
    name.scale.multiplyScalar(0.62)
    name.center.set(index % 2 === 0 ? -0.1 : 1.1, 0.5)
    name.position.copy(at)
    markers.add(dot, name)
  })

  galaxy.add(markers, root)
  galaxy.add(ship, root)

  return progress => {
    const at = galaxy.routePoint(progress)
    ship.position.copy(at)
    ship.lookAt(at.clone().add(galaxy.routeTangent(progress)))
  }
}

const steer = staged
  ? drawShip()
  : (progress: number): void => {}

const status = classed('p', 'm-0 text-lg font-extrabold')
const detail = classed('p', 'm-0 text-sm text-ink-soft')
const scrub = dom.element('input')
scrub.setAttribute('type', 'range')
scrub.setAttribute('min', '0')
scrub.setAttribute('max', String(durationDays))
scrub.setAttribute('step', '1')
scrub.setAttribute('aria-label', 'Fly through the voyage day by day')
scrub.setAttribute('class', 'w-full cursor-pointer accent-accent')
const hint = textOf('p', 'm-0 text-xs uppercase tracking-wider opacity-60', 'Drag to fly the route · drag the galaxy to look around')

const stopLabel = classed('p', EYEBROW)
const stopTitle = classed('p', 'm-0 text-lg font-extrabold text-accent')
const stopNote = classed('p', 'm-0 text-sm leading-relaxed')
const stopNext = classed('p', 'm-0 text-xs text-ink-soft')
const dots = stops.map(() => classed('span', DOT_AHEAD))
const track = classed('div', 'flex flex-wrap items-center gap-2 py-1')
track.setAttribute('aria-hidden', 'true')
track.append(...dots)
stopCard.setAttribute('aria-live', 'polite')
stopCard.append(stopLabel, stopTitle, stopNote, track, stopNext)
if (stops.length === 0) stopCard.setAttribute('class', 'hidden')
if (!staged) hint.replaceChildren(dom.text('Drag to follow the flight plan'))
card.append(status, detail, scrub, hint)

const reveal = (day: number): void => {
  if (stops.length === 0) return
  const index = Math.max(0, stops.filter(stop => day >= stop.day).length - 1)
  const current = stops[index]
  const next = stops[index + 1]
  stopLabel.replaceChildren(dom.text('Flight plan · stop ' + (index + 1) + ' of ' + stops.length))
  stopTitle.replaceChildren(dom.text('Day ' + current.day + ' · ' + current.name))
  stopNote.replaceChildren(dom.text(current.note))
  stopNext.replaceChildren(dom.text(next === undefined ? 'Final stop' : 'Next: day ' + next.day + ' · ' + next.name))
  dots.forEach((dot, position) => dot.setAttribute('class', position > index ? DOT_AHEAD : position === index ? DOT_CURRENT : DOT_PAST))
}

const place = (day: number): void => {
  const progress = Math.min(1, Math.max(0, day / durationDays))
  steer(progress)
  detail.replaceChildren(dom.text('Day ' + Math.round(day) + ' · ' +
    Math.round(progress * TOTAL_LIGHT_YEARS).toLocaleString('en-GB') + ' light-years from home'))
  reveal(day)
}

const home = stops.length > 0 ? stops[0].name : 'dock'
const goal = stops.length > 0 ? stops[stops.length - 1].name : 'the core'
const start = Date.parse(departure)
const elapsed = Number.isFinite(start) ? (Date.now() - start) / DAY : -1
const today = Math.min(durationDays, Math.max(0, elapsed))
status.replaceChildren(dom.text(
  elapsed < 0
    ? 'Docked at ' + home + ' · launch in ' + Math.ceil(-elapsed) + ' days'
    : elapsed < durationDays
      ? 'Under way · day ' + Math.floor(elapsed) + ' of ' + durationDays
      : 'Holding at ' + goal
))
scrub.setAttribute('value', String(Math.round(today)))
scrub.addEventListener('input', () => place(Number((scrub as HTMLInputElement).value)))
place(today)

return root
