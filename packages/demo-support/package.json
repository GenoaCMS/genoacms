{
  "name": "@genoacms/demo-support",
  "version": "0.0.0",
  "private": true,
  "description": "What the four consumer demos share: reading the instance's bucket, and the components they render",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./instance": {
      "types": "./dist/instance.d.ts",
      "import": "./dist/instance.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.ts",
      "import": "./dist/artifacts.js"
    },
    "./bucket": {
      "types": "./dist/bucket.d.ts",
      "import": "./dist/bucket.js"
    },
    "./site": {
      "types": "./dist/site.d.ts",
      "import": "./dist/site.js"
    },
    "./site.css": "./styles/site.css",
    "./galaxy": {
      "types": "./dist/galaxy.d.ts",
      "import": "./dist/galaxy.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@genoacms/sdk": "workspace:*",
    "@google-cloud/storage": "^7.7.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/three": "^0.181.0",
    "jsdom": "^24.1.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
