{
  "name": "@genoacms/demo-support",
  "version": "0.0.0",
  "private": true,
  "description": "What the four consumer demos share: reading the instance's bucket, and the components they render",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./instance": {
      "types": "./dist/instance.d.ts",
      "import": "./dist/instance.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.ts",
      "import": "./dist/artifacts.js"
    },
    "./bucket": {
      "types": "./dist/bucket.d.ts",
      "import": "./dist/bucket.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@genoacms/sdk": "workspace:*",
    "@google-cloud/storage": "^7.7.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "jsdom": "^24.1.3",
    "vite": "^7.3.1",
    "rimraf": "^6.1.3"
  }
}
