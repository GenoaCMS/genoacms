# Settings for a consumer demo. Copy to `.env` — which is gitignored — and fill in.
#
#   cp .env.example .env

# --- Public, and sent to the browser -----------------------------------------------------
# The instance's root trust anchor, base64, exactly as the CMS shows it under
# Configuration -> Keys -> Root trust anchor. Public by construction: it is what verification
# is for, and everything this application trusts follows from it.
VITE_GENOACMS_ROOT_PUBLIC_KEY=

# A page the instance has published. `pnpm --filter @genoacms/core run test:demo` publishes
# demoHome, demoFlat and demoEmpty.
VITE_GENOACMS_PAGE=demoHome

# Where the SDK fetches published documents from. Defaults to this dev server's own /artifacts
# route. Point it at a public mirror and the credentials below stop being needed.
# VITE_GENOACMS_ORIGIN=/artifacts

# --- Secret, and read only by the dev server ---------------------------------------------
# Needed only while the published documents live in a private bucket. A consumer should hold no
# credentials at all; publish mirrors are what remove these.

GENOACMS_BUCKET=genoacms

# The same service account `genoa.config` uses, as one line of JSON. From the repository root:
#
#   echo "GENOACMS_CREDENTIALS=$(jq -c . packages/core/genoa.config/gcp/serviceAccount.json)" >> packages/demo-vanilla/.env
GENOACMS_CREDENTIALS=
