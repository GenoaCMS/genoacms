{
  "name": "@genoacms/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Client SDK for GenoaCMS: verifies signed documents against an embedded root anchor, and executes and renders published pages in the browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenoaCMS/genoacms.git",
    "directory": "packages/sdk"
  },
  "author": {
    "name": "Filip Holčík",
    "email": "filip.holcik.official@gmail.com"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GenoaCMS/genoacms/issues"
  },
  "homepage": "https://github.com/GenoaCMS/genoacms/tree/main/packages/sdk#readme",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./verify": {
      "import": "./dist/verify/index.js",
      "types": "./dist/verify/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "conformance": "GENOACMS_CONFORMANCE_REQUIRED=1 vitest run src/verify/interop.test.ts"
  },
  "dependencies": {
    "@genoacms/internal": "workspace:^",
    "@noble/hashes": "^2.3.0",
    "@noble/post-quantum": "^0.7.0"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
