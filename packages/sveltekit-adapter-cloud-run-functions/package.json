{
	"name": "@genoacms/sveltekit-adapter-cloud-run-functions",
	"version": "1.0.1",
	"description": "Adapter for SvelteKit apps that generates a Cloud Run Function",
	"keywords": [
		"adapter",
		"deploy",
		"hosting",
		"Cloud Run",
		"svelte",
		"sveltekit"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GenoaCMS/genoacms.git",
		"directory": "packages/sveltekit-adapter-cloud-run-functions"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"files": [
		"files",
		"index.js",
		"index.d.ts"
	],
	"scripts": {
		"dev": "node -e \"fs.rmSync('files', { force: true, recursive: true })\" && rollup -cw",
		"build": "node -e \"fs.rmSync('files', { force: true, recursive: true })\" && rollup -c",
		"test": "vitest run",
		"check": "tsc",
		"lint": "prettier --check .",
		"format": "npm run lint --write",
		"prepublishOnly": "pnpm run build",
		"test:e2e": "vitest run --mode e2e e2e"
	},
	"devDependencies": {
		"@google-cloud/functions-framework": "^5.0.5",
		"@polka/url": "^1.0.0-next.28",
		"@sveltejs/kit": "^2.4.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^20.19.43",
		"polka": "^1.0.0-next.28",
		"prettier": "^3.5.0",
		"sirv": "^3.0.0",
		"svelte": "^5.53.5",
		"typescript": "^5.3.3",
		"vite": "^7.3.1",
		"vitest": "^2.0.1"
	},
	"dependencies": {
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^15.3.0",
		"rollup": "^4.9.5"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.4.0"
	}
}
