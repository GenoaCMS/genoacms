{
	"name": "@genoacms/sveltekit-adapter-cloud-run-functions",
	"version": "1.0.1",
	"description": "Adapter for SvelteKit apps that generates a Cloud Run Function",
	"keywords": [
		"adapter",
		"deploy",
		"hosting",
		"Cloud Run",
		"svelte",
		"sveltekit"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GenoaCMS/genoacms.git",
		"directory": "packages/sveltekit-adapter-cloud-run-functions"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"files": [
		"index.js",
		"index.d.ts",
		"ambient.d.ts",
		"src"
	],
	"scripts": {
		"test": "vitest run",
		"check": "tsc",
		"lint": "prettier --check .",
		"format": "npm run lint --write",
		"test:e2e": "vitest run --mode e2e e2e"
	},
	"devDependencies": {
		"@google-cloud/functions-framework": "^5.0.5",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.17.0",
		"polka": "^1.0.0-next.28",
		"prettier": "^3.5.0",
		"svelte": "^5.57.1",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@polka/url": "^1.0.0-next.28",
		"sirv": "^3.0.0"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0"
	}
}
